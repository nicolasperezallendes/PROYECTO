{"text": "<link rel=\"stylesheet\" href=\"fonts.css\">\n<style>\n/* Línea gráfica Narrativa: DM Sans, títulos grandes con una palabra destacada en fucsia,\n   esquinas rectas, banda casi negra con texto crema y paleta fucsia / morado / celeste / coral / turquesa. */\n#dash-root .nx {\n  --nx-pink: #ff6bbe; --nx-purple: #8b33a5; --nx-ink: #181818; --nx-blue: #00a0dc;\n  --nx-coral: #ff7f6e; --nx-teal: #00c0bd; --nx-cream: #f2e5e0; --nx-navy: #0b315c;\n  --nx-font: 'DM Sans JUNCOS', 'DM Sans', var(--font-anthropic-sans);\n  display: grid; gap: var(--cds-gap-xl); font-family: var(--nx-font); font-variant-numeric: tabular-nums;\n}\n#dash-root .nx-band { background: var(--nx-ink); color: var(--nx-cream); padding: var(--cds-pad-xl) var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); }\n#dash-root .nx-eyebrow { font-size: var(--cds-font-size-caption); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }\n#dash-root .nx-band .nx-eyebrow { color: var(--nx-pink); }\n#dash-root .nx-band h1 { margin: 0; font-family: var(--nx-font); font-weight: 700; font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.1; text-wrap: balance; color: var(--nx-cream); }\n#dash-root .nx-hl { color: var(--nx-pink); }\n#dash-root .nx-take { margin: 0; max-width: 70ch; font-size: var(--cds-font-size-body); font-weight: 300; line-height: 1.5; color: var(--nx-cream); }\n#dash-root .nx-take b { font-weight: 700; color: var(--nx-cream); }\n#dash-root .nx-when { margin: 0; font-size: var(--cds-font-size-caption); opacity: .75; color: var(--nx-cream); }\n#dash-root .nx-tabs { display: flex; flex-wrap: wrap; gap: 0; border-bottom: 2px solid var(--color-fg); }\n#dash-root .nx-tab { all: unset; cursor: pointer; padding: var(--cds-pad-sm) var(--cds-pad-lg); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .nx-tab[aria-selected=\"true\"] { background: var(--color-fg); color: var(--color-bg); }\n#dash-root .nx-tab:focus-visible { outline: 2px solid var(--nx-pink); outline-offset: 2px; }\n#dash-root .nx-view { display: grid; gap: var(--cds-gap-xl); }\n#dash-root .nx-h2 { margin: 0; font-family: var(--nx-font); font-weight: 700; font-size: var(--cds-font-size-title); line-height: 1.15; text-wrap: balance; }\n#dash-root .nx-lede { margin: 0; color: var(--color-fg-muted); font-weight: 300; max-width: 75ch; }\n#dash-root .nx-tiles { display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); border-top: 1px solid var(--color-border-line); border-left: 1px solid var(--color-border-line); }\n#dash-root .nx-tile { padding: var(--cds-pad-lg); border-right: 1px solid var(--color-border-line); border-bottom: 1px solid var(--color-border-line); display: grid; gap: var(--cds-gap-xs); align-content: start; }\n#dash-root .nx-tile .lbl { font-size: var(--cds-font-size-caption); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--color-fg-muted); }\n#dash-root .nx-tile .big { font-family: var(--nx-font); font-weight: 700; font-size: 2.4rem; line-height: 1; min-height: 1em; }\n#dash-root .nx-tile .note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .nx-tile.acc .big { color: var(--nx-pink); }\n#dash-root .nx-card { border: 1px solid var(--color-border-line); padding: var(--cds-pad-lg); min-width: 0; display: grid; gap: var(--cds-gap-sm); align-content: start; background: var(--color-panel); }\n#dash-root .nx-card h3 { margin: 0; font-family: var(--nx-font); font-size: var(--cds-font-size-heading); font-weight: 700; }\n#dash-root .nx-card .sub { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 85ch; }\n#dash-root .nx-grid2 { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }\n#dash-root .nx-chart { position: relative; min-height: 200px; }\n#dash-root .nx-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .nx-legend i { display: inline-block; width: .65rem; height: .65rem; margin-right: .35rem; vertical-align: middle; }\n#dash-root .nx-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); max-width: 19rem; z-index: 2; }\n#dash-root .nx-tip .t { color: var(--cds-text-secondary); font-weight: 700; }\n#dash-root .nx-scroll { overflow-x: auto; }\n#dash-root table.nx-t { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); }\n#dash-root .nx-t th { text-align: left; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 2px solid var(--color-fg); white-space: nowrap; }\n#dash-root .nx-t th button { all: unset; cursor: pointer; }\n#dash-root .nx-t th button:focus-visible { outline: 2px solid var(--nx-pink); outline-offset: 2px; }\n#dash-root .nx-t td { padding: var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n#dash-root .nx-t td.num, #dash-root .nx-t th.num { text-align: right; white-space: nowrap; }\n#dash-root .nx-t td.code { white-space: nowrap; font-weight: 700; }\n#dash-root .nx-t td.wide { min-width: 14rem; }\n#dash-root .nx-t tr.closed td { color: var(--color-fg-muted); }\n#dash-root .nx-t a { color: inherit; text-decoration-color: var(--nx-pink); text-underline-offset: 3px; }\n#dash-root .nx-pill { display: inline-block; padding: 2px 8px; font-size: var(--cds-font-size-caption); font-weight: 700; white-space: nowrap; color: var(--nx-ink); background: var(--nx-cream); }\n#dash-root .nx-pill.urg { background: var(--nx-coral); }\n#dash-root .nx-pill.ok { background: var(--nx-teal); }\n#dash-root .nx-pill.warn { background: var(--nx-pink); }\n#dash-root .nx-pill.mute { background: transparent; color: var(--color-fg-muted); border: 1px solid var(--color-border-line); }\n#dash-root .nx-rel { display: block; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .nx-rel.hot { color: var(--color-bad); font-weight: 700; }\n#dash-root .nx-search { width: 100%; max-width: 20rem; padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); background: var(--color-bg); color: var(--color-fg); font: inherit; }\n#dash-root .nx-list { display: grid; gap: var(--cds-gap-sm); margin: 0; padding: 0; list-style: none; }\n#dash-root .nx-list li { display: grid; grid-template-columns: .6rem 1fr; gap: var(--cds-gap-sm); align-items: baseline; font-size: var(--cds-font-size-caption); }\n#dash-root .nx-list li .dot { width: .55rem; height: .55rem; background: var(--color-fg-muted); }\n#dash-root .nx-list li.alerta .dot { background: var(--nx-coral); }\n#dash-root .nx-list li.revisar .dot { background: var(--nx-pink); }\n#dash-root .nx-list li.ok .dot { background: var(--nx-teal); }\n#dash-root .nx-list li b { font-weight: 700; }\n#dash-root ol.nx-sug { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: var(--cds-gap-md); }\n#dash-root ol.nx-sug li { counter-increment: s; display: grid; grid-template-columns: 2.2rem 1fr; gap: var(--cds-gap-sm); align-items: baseline; max-width: 85ch; }\n#dash-root ol.nx-sug li::before { content: counter(s, decimal-leading-zero); font-weight: 700; color: var(--nx-pink); font-size: 1.2rem; }\n#dash-root .nx-empty { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; }\n#dash-root .nx-fail { display: flex; align-items: center; justify-content: center; gap: .5rem; min-height: 4rem; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n#dash-root .nx-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n#dash-root .nx-foot { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; max-width: 90ch; }\n#dash-root [data-dash-source-state=empty] { color: transparent; }\n#dash-root [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"nx\">\n  <header class=\"nx-band\" id=\"inicio\">\n    <span class=\"nx-eyebrow\">JUNCOS E.I.R.L. · Mercado Público</span>\n    <h1>Licitaciones y Compras Ágiles, <span class=\"nx-hl\">a partir de los datos</span></h1>\n    <p class=\"nx-take dash-skeleton\" id=\"takeaway\">—</p>\n    <p class=\"nx-when\"><span data-source=\"consulta\" data-field=\"consultado\" data-row=\"0\" id=\"cuando\" class=\"dash-skeleton\">—</span></p>\n  </header>\n\n  <nav class=\"nx-tabs\" role=\"tablist\" aria-label=\"Vistas\">\n    <button class=\"nx-tab\" role=\"tab\" type=\"button\" id=\"tab-hoy\" data-view=\"hoy\" aria-selected=\"true\">Hoy</button>\n    <button class=\"nx-tab\" role=\"tab\" type=\"button\" id=\"tab-mejora\" data-view=\"mejora\" aria-selected=\"false\">Mejora de procesos</button>\n  </nav>\n\n  <section class=\"nx-view\" id=\"hoy\" role=\"tabpanel\" aria-labelledby=\"tab-hoy\">\n    <div class=\"nx-tiles\" id=\"cifras\" aria-label=\"Cifras clave\">\n      <div class=\"nx-tile acc\"><span class=\"lbl\">Compras Ágiles abiertas</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"ca_abiertas\" data-row=\"0\">—</span><span class=\"note\">en seguimiento</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Monto disponible</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"ca_monto_abiertas\" data-row=\"0\">—</span><span class=\"note\">de esas Compras Ágiles, con impuestos</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Licitaciones abiertas</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"lic_abiertas\" data-row=\"0\">—</span><span class=\"note\">en seguimiento</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Cierran en 72 h</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"cierran_72h\" data-row=\"0\">—</span><span class=\"note\">Compras Ágiles y licitaciones</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Tareas pendientes</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"tareas_pendientes\" data-row=\"0\">—</span><span class=\"note\">de la empresa</span></div>\n    </div>\n\n    <section class=\"nx-card\" id=\"calendario\">\n      <h3>Calendario de cierres</h3>\n      <p class=\"sub\">Una línea por proceso abierto, desde la consulta hasta su cierre. Los de la Región de Coquimbo van en negrita.</p>\n      <div class=\"nx-legend\" id=\"leyenda\"></div>\n      <div class=\"nx-chart\" id=\"chart\" data-source=\"cierres\"></div>\n      <p class=\"nx-empty\" id=\"chart-vacio\" hidden>No hay procesos abiertos en seguimiento a la hora de la consulta.</p>\n    </section>\n\n    <section class=\"nx-card\" id=\"compras-agiles\">\n      <h3>Compras Ágiles en seguimiento</h3>\n      <p class=\"sub\">El número es la prioridad: primero las que conviene cotizar (CA3 de 7 o más, o listas para enviar), por fecha de cierre. El neto máximo es el monto dividido por 1,19.</p>\n      <label class=\"sub\" for=\"buscar-ca\">Buscar</label>\n      <input id=\"buscar-ca\" class=\"nx-search\" type=\"search\" placeholder=\"Código, organismo o región\">\n      <div class=\"nx-scroll\">\n        <table class=\"nx-t\" id=\"tabla-ca\" data-source=\"compras_agiles\" data-row-key=\"codigo\">\n          <thead><tr>\n            <th data-field=\"prioridad\"><button type=\"button\" data-k=\"prioridad\">#</button></th>\n            <th data-field=\"codigo\"><button type=\"button\" data-k=\"codigo\">Código</button></th>\n            <th data-field=\"nombre\">Qué piden</th>\n            <th data-field=\"organismo\"><button type=\"button\" data-k=\"organismo\">Organismo</button></th>\n            <th data-field=\"region\"><button type=\"button\" data-k=\"region\">Región</button></th>\n            <th data-field=\"monto_clp\" class=\"num\"><button type=\"button\" data-k=\"monto_clp\">Monto</button></th>\n            <th data-field=\"neto_max_clp\" class=\"num\">Neto máx.</th>\n            <th data-field=\"cierre\"><button type=\"button\" data-k=\"cierre\">Cierre</button></th>\n            <th data-field=\"ofertas_api_hoy\" class=\"num\">Ofertas</th>\n            <th data-field=\"ca3\" class=\"num\"><button type=\"button\" data-k=\"ca3\">CA3</button></th>\n            <th data-field=\"estado_juncos\">Estado</th>\n            <th data-field=\"rubro\">Rubro</th>\n            <th data-field=\"proximo_paso\">Próximo paso</th>\n          </tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n      <p class=\"nx-foot\">Ofertas: mientras una Compra Ágil está abierta, la API muestra 0 o un número desfasado. El conteo real aparece al cerrar.</p>\n    </section>\n\n    <section class=\"nx-card\" id=\"licitaciones\">\n      <h3>Licitaciones en seguimiento</h3>\n      <p class=\"sub\">Ordenadas por cierre. El código abre la ficha en Mercado Público.</p>\n      <div class=\"nx-scroll\">\n        <table class=\"nx-t\" id=\"tabla-lic\" data-source=\"licitaciones\" data-row-key=\"codigo\">\n          <thead><tr>\n            <th data-field=\"codigo\">Código</th>\n            <th data-field=\"nombre\">Objeto</th>\n            <th data-field=\"organismo\">Organismo</th>\n            <th data-field=\"region\">Región</th>\n            <th data-field=\"monto_clp\" class=\"num\">Monto</th>\n            <th data-field=\"cierre\">Cierre</th>\n            <th data-field=\"estado_juncos\">Estado</th>\n            <th data-field=\"proximo_paso\">Próximo paso</th>\n          </tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </section>\n\n    <div class=\"nx-grid2\">\n      <section class=\"nx-card\" id=\"tareas\">\n        <h3>Tareas de la empresa</h3>\n        <p class=\"sub\">Primero las urgentes, al final las ya hechas.</p>\n        <div class=\"nx-scroll\">\n          <table class=\"nx-t\" id=\"tabla-tareas\" data-source=\"tareas\" data-row-key=\"n\">\n            <thead><tr>\n              <th data-field=\"n\">N°</th>\n              <th data-field=\"tarea\">Tarea</th>\n              <th data-field=\"plazo\">Plazo</th>\n              <th data-field=\"estado\">Estado</th>\n            </tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </section>\n      <section class=\"nx-card\" id=\"empresa\">\n        <h3>Ficha de la empresa</h3>\n        <p class=\"sub\">CONSULTORES NICOLÁS PÉREZ ALLENDES E.I.R.L. (JUNCOS), RUT 78.390.884-0.</p>\n        <ul class=\"nx-list\" id=\"lista-empresa\"></ul>\n      </section>\n    </div>\n  </section>\n\n  <section class=\"nx-view\" id=\"mejora\" role=\"tabpanel\" aria-labelledby=\"tab-mejora\" hidden>\n    <div>\n      <h2 class=\"nx-h2\">Qué aprendemos de <span class=\"nx-hl\">cada proceso</span></h2>\n      <p class=\"nx-lede\">Cada Compra Ágil y licitación queda en el registro: de qué búsqueda salió, qué recomendó Claude, qué decidió Nicolás y cómo terminó. Con eso se ajusta la búsqueda y se fijan mejor los precios.</p>\n    </div>\n\n    <div class=\"nx-tiles\" id=\"cifras-mejora\" aria-label=\"Cifras de mejora\">\n      <div class=\"nx-tile\"><span class=\"lbl\">En el registro</span><span class=\"big dash-skeleton\" data-source=\"mejora_resumen\" data-field=\"procesos\" data-row=\"0\">—</span><span class=\"note\">procesos revisados</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Con resultado</span><span class=\"big dash-skeleton\" data-source=\"mejora_resumen\" data-field=\"con_resultado\" data-row=\"0\">—</span><span class=\"note\">ganador o cierre final conocido</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Cotizados</span><span class=\"big dash-skeleton\" data-source=\"mejora_resumen\" data-field=\"cotizados\" data-row=\"0\">—</span><span class=\"note\">por JUNCOS</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Ganados</span><span class=\"big dash-skeleton\" data-source=\"mejora_resumen\" data-field=\"ganados\" data-row=\"0\">—</span><span class=\"note\">órdenes de compra o adjudicaciones</span></div>\n      <div class=\"nx-tile acc\"><span class=\"lbl\">Precio ganador</span><span class=\"big dash-skeleton\" data-source=\"mejora_resumen\" data-field=\"mediana_ratio_ganador\" data-row=\"0\">—</span><span class=\"note\">mediana, como % del monto disponible</span></div>\n      <div class=\"nx-tile\"><span class=\"lbl\">Claude y Nicolás</span><span class=\"big dash-skeleton\" data-source=\"mejora_resumen\" data-field=\"concordancia\" data-row=\"0\">—</span><span class=\"note\" id=\"nota-concordancia\">coincidencia entre recomendación y decisión</span></div>\n    </div>\n\n    <section class=\"nx-card\" id=\"precios\">\n      <h3>¿A qué precio se gana?</h3>\n      <p class=\"sub\">Cada fila es un proceso cerrado. El punto morado o celeste es lo que ofertó el ganador, como porcentaje del monto disponible; el fucsia, lo que ofertó JUNCOS cuando se conoce. La línea punteada es la mediana de los ganadores.</p>\n      <div class=\"nx-legend\" id=\"leyenda-precios\"></div>\n      <div class=\"nx-chart\" id=\"chart-precios\" data-source=\"resultados\"></div>\n    </section>\n\n    <section class=\"nx-card\" id=\"sugerencias\">\n      <h3>Sugerencias de la semana</h3>\n      <p class=\"sub\">Salen de las métricas del registro. No se aplican solas: Claude las verifica y las propone, y Nicolás decide.</p>\n      <ol class=\"nx-sug\" id=\"lista-sug\" data-source=\"mejora_sugerencias\"></ol>\n    </section>\n\n    <section class=\"nx-card\" id=\"resultados\">\n      <h3>Resultados al cierre</h3>\n      <p class=\"sub\">Quién ganó y a qué precio. «JUNCOS» indica si aparece entre los oferentes visibles; la API muestra solo parte de ellos.</p>\n      <div class=\"nx-scroll\">\n        <table class=\"nx-t\" id=\"tabla-res\" data-source=\"resultados\" data-row-key=\"codigo\">\n          <thead><tr>\n            <th data-field=\"codigo\">Código</th>\n            <th data-field=\"nombre\">Proceso</th>\n            <th data-field=\"organismo\">Organismo</th>\n            <th data-field=\"estado_final\">Resultado</th>\n            <th data-field=\"ofertas_final\" class=\"num\">Ofertas</th>\n            <th data-field=\"ganador\">Ganador</th>\n            <th data-field=\"precio_ganador\" class=\"num\">Precio ganador</th>\n            <th data-field=\"ratio_ganador\" class=\"num\">% del monto</th>\n            <th data-field=\"precio_ofertado\" class=\"num\">JUNCOS ofertó</th>\n            <th data-field=\"notas\">Notas</th>\n          </tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </section>\n\n    <div class=\"nx-grid2\">\n      <section class=\"nx-card\" id=\"terminos\">\n        <h3>¿Qué búsquedas rinden?</h3>\n        <p class=\"sub\">Procesos afines que trajo cada término en los últimos 30 días, y cuántos se cotizaron. Se mide desde el 06-11-2026.</p>\n        <div class=\"nx-chart\" id=\"chart-terminos\" data-source=\"mejora_terminos\"></div>\n      </section>\n      <section class=\"nx-card\" id=\"precios-grupo\">\n        <h3>Precio ganador por tipo de proceso</h3>\n        <p class=\"sub\">Mediana del precio ganador como % del monto disponible, y mediana de ofertas recibidas.</p>\n        <div class=\"nx-scroll\">\n          <table class=\"nx-t\" id=\"tabla-precios\" data-source=\"mejora_precios\" data-row-key=\"grupo\">\n            <thead><tr>\n              <th data-field=\"grupo\">Tipo · línea</th>\n              <th data-field=\"resultados\" class=\"num\">Resultados</th>\n              <th data-field=\"mediana_ratio\" class=\"num\">Mediana precio</th>\n              <th data-field=\"mediana_ofertas\" class=\"num\">Mediana ofertas</th>\n            </tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n        <h3>Motivos de descarte</h3>\n        <ul class=\"nx-list\" id=\"lista-motivos\" data-source=\"mejora_motivos\"></ul>\n      </section>\n    </div>\n  </section>\n</div>\n\n<script>\ndash.calc('resumen', {\n  title: 'Resumen de procesos abiertos',\n  description: 'Cuenta lo abierto a la hora de la consulta, suma el monto disponible de las Compras Ágiles abiertas y cuenta las tareas sin hacer.',\n  inputs: ['compras_agiles', 'licitaciones', 'tareas', 'consulta'],\n  fn: (compras_agiles, licitaciones, tareas, consulta) => {\n    const t0 = new Date(consulta[0].consultado).getTime();\n    const t72 = t0 + 72 * 3600 * 1000;\n    const abierta = (r) => r.cierre && new Date(r.cierre).getTime() > t0;\n    const ca = compras_agiles.filter(abierta);\n    const lic = licitaciones.filter(abierta);\n    const pronto = ca.concat(lic).filter((r) => new Date(r.cierre).getTime() <= t72);\n    return [{\n      ca_abiertas: ca.length,\n      ca_monto_abiertas: ca.reduce((s, r) => s + (r.monto_clp || 0), 0),\n      lic_abiertas: lic.length,\n      cierran_72h: pronto.length,\n      tareas_pendientes: tareas.filter((r) => r.estado !== 'Hecho').length\n    }];\n  }\n});\n\ndash.calc('cierres', {\n  title: 'Cierres de procesos abiertos',\n  description: 'Une Compras Ágiles y licitaciones abiertas a la hora de la consulta, ordenadas por cierre.',\n  inputs: ['compras_agiles', 'licitaciones', 'consulta'],\n  fn: (compras_agiles, licitaciones, consulta) => {\n    const t0 = new Date(consulta[0].consultado).getTime();\n    const pick = (tipo) => (r) => ({ codigo: r.codigo, tipo, nombre: r.nombre, organismo: r.organismo, region: r.region, en_region_coquimbo: r.en_region_coquimbo, monto_clp: r.monto_clp, cierre: r.cierre, estado_juncos: r.estado_juncos });\n    return compras_agiles.map(pick('Compra Ágil')).concat(licitaciones.map(pick('Licitación')))\n      .filter((r) => r.cierre && new Date(r.cierre).getTime() > t0)\n      .sort((a, b) => new Date(a.cierre) - new Date(b.cierre));\n  }\n});\n\n(function () {\n  const TZ = 'America/Santiago';\n  const C = { pink: '#ff6bbe', purple: '#8b33a5', blue: '#00a0dc', coral: '#ff7f6e', teal: '#00c0bd' };\n  const clp = new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 });\n  const clpCorto = (v) => v >= 1e6 ? '$' + (v / 1e6).toLocaleString('es-CL', { maximumFractionDigits: 1 }) + ' M' : clp.format(v);\n  const pct = (v) => v == null || v === '' ? '—' : Math.round(Number(v) * 100) + '%';\n  const partes = (d) => Object.fromEntries(new Intl.DateTimeFormat('es-CL', { weekday: 'short', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: TZ }).formatToParts(d).map((p) => [p.type, p.value]));\n  const fecha = (iso) => { if (!iso) return '—'; const p = partes(new Date(iso)); return `${p.weekday.replace('.', '')} ${p.day}-${p.month}, ${p.hour}:${p.minute}`; };\n  const fechaCorta = (d) => { const p = partes(d); return `${p.weekday.replace('.', '')} ${p.day}-${p.month}`; };\n  const diaCL = (d) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(d);\n  const relativo = (iso) => {\n    if (!iso) return { txt: 'sin fecha', hot: false };\n    const c = new Date(iso), now = new Date();\n    if (c <= now) return { txt: 'cerrada', hot: false };\n    const dd = Math.round((new Date(diaCL(c)) - new Date(diaCL(now))) / 864e5);\n    if (dd === 0) return { txt: 'cierra hoy', hot: true };\n    if (dd === 1) return { txt: 'cierra mañana', hot: true };\n    return { txt: `en ${dd} días`, hot: false };\n  };\n  const pillClase = (e) => /hoy|Revisar|ganada/i.test(e) ? (/ganada/i.test(e) ? 'ok' : 'urg') : /Lista|Postulando|Cotizada|Hecho/.test(e) ? 'ok' : /Cerr|Vencida|Alternativa|UTP|adjudicada|desierta/i.test(e) ? 'mute' : /Pendiente|En curso/.test(e) ? 'warn' : '';\n  const pill = (txt) => { const s = document.createElement('span'); s.className = 'nx-pill ' + pillClase(txt || ''); s.textContent = txt || '—'; return s; };\n  const td = (tr, txt, cls) => { const c = tr.insertCell(); if (cls) c.className = cls; if (txt instanceof Node) c.append(txt); else c.textContent = txt == null || txt === '' ? '—' : txt; return c; };\n  const fallo = (el) => { el.replaceChildren(); const d = document.createElement('div'); d.className = 'nx-fail'; d.textContent = 'Failed to load'; el.append(d); };\n  const sinSkel = (...els) => els.forEach((e) => e && e.classList.remove('dash-skeleton'));\n\n  // Pestañas, con enlace directo (#hoy, #mejora)\n  const vistas = ['hoy', 'mejora'];\n  const mostrar = (v) => {\n    vistas.forEach((x) => { document.getElementById(x).hidden = x !== v; document.getElementById('tab-' + x).setAttribute('aria-selected', String(x === v)); });\n    dash.setLink(v);\n    dibujar();\n  };\n  document.querySelectorAll('.nx-tab').forEach((b) => b.addEventListener('click', () => mostrar(b.dataset.view)));\n\n  let ordenCA = { k: 'prioridad', dir: 1 };\n  document.querySelectorAll('#tabla-ca th button').forEach((b) => b.addEventListener('click', () => {\n    const k = b.dataset.k; ordenCA = { k, dir: ordenCA.k === k ? -ordenCA.dir : 1 };\n    document.querySelectorAll('#tabla-ca th').forEach((th) => th.removeAttribute('aria-sort'));\n    b.closest('th').setAttribute('aria-sort', ordenCA.dir > 0 ? 'ascending' : 'descending');\n    dibujar();\n  }));\n  document.getElementById('buscar-ca').addEventListener('input', () => dibujar());\n\n  function tablaCA() {\n    const body = document.querySelector('#tabla-ca tbody');\n    const s = dash.data('compras_agiles');\n    if (s.status !== 'ok') return;\n    const q = document.getElementById('buscar-ca').value.trim().toLowerCase();\n    const { k, dir } = ordenCA;\n    const val = (r) => k === 'cierre' ? (r.cierre ? new Date(r.cierre).getTime() : null) : r[k];\n    const rows = s.data.filter((r) => !q || [r.codigo, r.organismo, r.region, r.nombre].join(' ').toLowerCase().includes(q))\n      .slice().sort((a, b) => {\n        const va = val(a), vb = val(b);\n        if (va == null && vb == null) return 0; if (va == null) return 1; if (vb == null) return -1;\n        return (typeof va === 'number' ? va - vb : String(va).localeCompare(String(vb), 'es')) * dir;\n      });\n    body.replaceChildren();\n    rows.forEach((r) => {\n      const tr = body.insertRow();\n      const rel = relativo(r.cierre);\n      if (rel.txt === 'cerrada') tr.className = 'closed';\n      td(tr, r.prioridad == null ? '—' : r.prioridad, 'num');\n      td(tr, r.codigo, 'code');\n      td(tr, r.nombre, 'wide');\n      td(tr, r.organismo);\n      td(tr, r.region);\n      td(tr, r.monto_clp == null ? '—' : clp.format(r.monto_clp), 'num');\n      td(tr, r.neto_max_clp == null ? '—' : clp.format(r.neto_max_clp), 'num');\n      const c = td(tr, fecha(r.cierre)); c.style.whiteSpace = 'nowrap';\n      const sp = document.createElement('span'); sp.className = 'nx-rel' + (rel.hot ? ' hot' : ''); sp.textContent = rel.txt + (r.llamado === 'Segundo llamado' ? ' · 2.º llamado' : ''); c.append(sp);\n      td(tr, r.ofertas_api_hoy, 'num');\n      td(tr, r.ca3 == null ? '—' : r.ca3, 'num');\n      td(tr, pill(r.estado_juncos));\n      td(tr, r.rubro);\n      td(tr, r.proximo_paso, 'wide');\n    });\n  }\n\n  function tablaLic() {\n    const body = document.querySelector('#tabla-lic tbody');\n    const s = dash.data('licitaciones');\n    if (s.status !== 'ok') return;\n    body.replaceChildren();\n    s.data.slice().sort((a, b) => new Date(a.cierre || 0) - new Date(b.cierre || 0)).forEach((r) => {\n      const tr = body.insertRow();\n      const rel = relativo(r.cierre);\n      if (rel.txt === 'cerrada') tr.className = 'closed';\n      const a = document.createElement('a'); a.href = r.ficha; a.target = '_blank'; a.rel = 'noopener'; a.textContent = r.codigo;\n      td(tr, a, 'code');\n      td(tr, r.nombre, 'wide');\n      td(tr, r.organismo);\n      td(tr, r.region);\n      td(tr, r.monto_clp == null ? 'No publica' : clp.format(r.monto_clp), 'num');\n      const c = td(tr, fecha(r.cierre)); c.style.whiteSpace = 'nowrap';\n      const sp = document.createElement('span'); sp.className = 'nx-rel' + (rel.hot ? ' hot' : ''); sp.textContent = rel.txt; c.append(sp);\n      td(tr, pill(r.estado_juncos));\n      td(tr, r.proximo_paso, 'wide');\n    });\n  }\n\n  function tablaTareas() {\n    const body = document.querySelector('#tabla-tareas tbody');\n    const s = dash.data('tareas');\n    if (s.status !== 'ok') return;\n    const peso = (r) => r.estado === 'Hecho' ? 3 : /^(Hoy|Antes del lun|\\*\\*)/.test(r.plazo) ? 0 : r.estado === 'Revisar' ? 1 : 2;\n    body.replaceChildren();\n    s.data.slice().sort((a, b) => peso(a) - peso(b) || a.n - b.n).forEach((r) => {\n      const tr = body.insertRow();\n      if (r.estado === 'Hecho') tr.className = 'closed';\n      td(tr, r.n, 'num');\n      td(tr, r.tarea, 'wide');\n      td(tr, r.plazo);\n      td(tr, pill(r.estado));\n    });\n  }\n\n  function empresa() {\n    const ul = document.getElementById('lista-empresa');\n    const s = dash.data('empresa');\n    if (s.status === 'error') { fallo(ul); return; }\n    if (s.status !== 'ok') return;\n    ul.replaceChildren();\n    s.data.forEach((r) => {\n      const li = document.createElement('li'); li.className = r.nivel;\n      const dot = document.createElement('span'); dot.className = 'dot';\n      const tx = document.createElement('span');\n      const b = document.createElement('b'); b.textContent = r.item + ': ';\n      const v = document.createElement('span'); v.textContent = r.valor;\n      v.setAttribute('data-source', 'empresa'); v.setAttribute('data-field', 'valor'); v.setAttribute('data-where', 'id=' + encodeURIComponent(r.id));\n      tx.append(b, v); li.append(dot, tx); ul.append(li);\n    });\n  }\n\n  function cifras(id, fuente, fmt) {\n    const s = dash.data(fuente);\n    document.querySelectorAll(`#${id} [data-source=\"${fuente}\"]`).forEach((el) => {\n      if (s.status !== 'ok') { if (s.status === 'error') { sinSkel(el); el.textContent = '—'; } return; }\n      sinSkel(el);\n      const v = s.data[0] ? s.data[0][el.dataset.field] : null;\n      el.textContent = fmt(el.dataset.field, v);\n    });\n  }\n\n  function cabecera() {\n    const take = document.getElementById('takeaway');\n    const cuando = document.getElementById('cuando');\n    const c = dash.data('consulta');\n    if (c.status === 'ok') {\n      sinSkel(cuando);\n      const p = partes(new Date(c.data[0].consultado));\n      cuando.textContent = `Datos de Mercado Público consultados el ${p.weekday.replace('.', '')} ${p.day}-${p.month} a las ${p.hour}:${p.minute} (hora de Chile).`;\n    }\n    const s = dash.data('cierres');\n    const m = dash.data('mejora_resumen');\n    if (s.status !== 'ok') return;\n    sinSkel(take);\n    take.replaceChildren();\n    const now = new Date();\n    const vivos = s.data.filter((r) => new Date(r.cierre) > now);\n    if (vivos.length) {\n      const r = vivos[0];\n      const i = s.data.indexOf(r);\n      const b = document.createElement('b'); b.textContent = r.nombre; b.setAttribute('data-source', 'cierres'); b.setAttribute('data-field', 'nombre'); b.setAttribute('data-row', String(i));\n      take.append(document.createTextNode('El próximo cierre es '), b, document.createTextNode(` (${r.codigo}, ${r.organismo}), ${fecha(r.cierre)}.`));\n    } else {\n      take.append(document.createTextNode('No hay procesos abiertos en seguimiento a la hora de la consulta.'));\n    }\n    if (m.status === 'ok' && m.data[0] && m.data[0].mediana_ratio_ganador) {\n      const b = document.createElement('b'); b.textContent = pct(m.data[0].mediana_ratio_ganador);\n      b.setAttribute('data-source', 'mejora_resumen'); b.setAttribute('data-field', 'mediana_ratio_ganador'); b.setAttribute('data-row', '0');\n      take.append(document.createTextNode(' En los procesos cerrados, el ganador ofertó en mediana el '), b, document.createTextNode(' del monto disponible.'));\n    }\n  }\n\n  function tooltip(box) {\n    const tip = document.createElement('div'); tip.className = 'nx-tip'; tip.hidden = true; box.append(tip);\n    return {\n      show(ev, lineas) {\n        tip.hidden = false; tip.replaceChildren();\n        lineas.forEach((t, i) => { const d = document.createElement('div'); if (i === 0) d.className = 't'; d.textContent = t; tip.append(d); });\n        const [mx, my] = d3.pointer(ev, box);\n        tip.style.left = Math.max(0, Math.min(mx + 12, box.clientWidth - tip.offsetWidth)) + 'px';\n        tip.style.top = (my + 14) + 'px';\n      },\n      hide() { tip.hidden = true; }\n    };\n  }\n  const leyenda = (el, items) => el.replaceChildren(...items.map(([k, col]) => { const sp = document.createElement('span'); const i = document.createElement('i'); i.style.background = col; sp.append(i, document.createTextNode(k)); return sp; }));\n  const textoCorto = function (max) { let t = this.textContent; while (this.getComputedTextLength() > max && t.length > 4) { t = t.slice(0, -2); this.textContent = t + '…'; } };\n\n  function grafCierres() {\n    const box = document.getElementById('chart');\n    const s = dash.data('cierres');\n    const c = dash.data('consulta');\n    if (s.status === 'error') { fallo(box); return; }\n    if (s.status !== 'ok' || c.status !== 'ok') return;\n    box.replaceChildren();\n    const rows = s.data;\n    document.getElementById('chart-vacio').hidden = rows.length > 0;\n    box.hidden = !rows.length;\n    const colores = { 'Compra Ágil': C.blue, 'Licitación': C.purple };\n    leyenda(document.getElementById('leyenda'), Object.entries(colores));\n    if (!rows.length) return;\n    const W = Math.max(280, box.clientWidth), apilado = W < 620, rowH = apilado ? 40 : 26, top = 26, bottom = 8;\n    const t0 = new Date(c.data[0].consultado), tMax = d3.max(rows, (r) => new Date(r.cierre));\n    const H = top + rows.length * rowH + bottom;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Calendario de cierres');\n    const etiqueta = (r) => `${r.codigo.replace(/-(COT|LE|LP|L1)26$/, '')} · ${r.organismo}`;\n    let left = 8;\n    if (!apilado) {\n      const tmp = svg.append('text').attr('font-size', 12).style('font-family', 'var(--nx-font)');\n      left = 8 + Math.min(W * 0.42, d3.max(rows, (r) => { tmp.text(etiqueta(r)); return tmp.node().getComputedTextLength(); }));\n      tmp.remove();\n    }\n    const x = d3.scaleUtc([t0, d3.utcHour.offset(tMax, 6)], [left, W - 56]);\n    const dias = d3.utcDay.range(d3.utcDay.ceil(t0), tMax);\n    const paso = Math.max(1, Math.ceil(dias.length / Math.max(2, Math.floor((W - left - 56) / 70))));\n    const g = svg.append('g');\n    g.selectAll('line.grid').data(dias).join('line').attr('x1', (d) => x(d)).attr('x2', (d) => x(d)).attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', 'var(--cds-chart-grid)');\n    g.selectAll('text.tick').data(dias.filter((_, i) => i % paso === 0)).join('text').attr('x', (d) => x(d) + 3).attr('y', 12).attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--nx-font)').text((d) => fechaCorta(d3.utcHour.offset(d, 12)));\n    const tip = tooltip(box);\n    const fila = g.selectAll('g.r').data(rows).join('g').attr('transform', (r, i) => `translate(0, ${top + i * rowH})`);\n    fila.append('text').attr('x', apilado ? 0 : left - 8).attr('y', apilado ? 13 : 16).attr('text-anchor', apilado ? 'start' : 'end').attr('font-size', 12)\n      .attr('font-weight', (r) => r.en_region_coquimbo ? 700 : 400).attr('fill', 'var(--color-fg)').style('font-family', 'var(--nx-font)')\n      .text(etiqueta).each(function () { textoCorto.call(this, apilado ? W - 4 : left - 12); });\n    const yL = apilado ? 28 : 12;\n    fila.append('line').attr('x1', x(t0)).attr('x2', (r) => x(new Date(r.cierre))).attr('y1', yL).attr('y2', yL).attr('stroke', (r) => colores[r.tipo]).attr('stroke-width', 3).attr('opacity', .45);\n    fila.append('rect').attr('x', (r) => x(new Date(r.cierre)) - 5).attr('y', yL - 5).attr('width', 10).attr('height', 10).attr('fill', (r) => colores[r.tipo]);\n    fila.append('text').attr('x', (r) => x(new Date(r.cierre)) + 9).attr('y', yL + 4).attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--nx-font)')\n      .text((r) => { const p = partes(new Date(r.cierre)); return `${p.day}-${p.month}`; });\n    fila.append('rect').attr('x', 0).attr('y', 0).attr('width', W).attr('height', rowH).attr('fill', 'transparent')\n      .on('mousemove', (ev, r) => tip.show(ev, [`${r.tipo} · ${r.codigo}`, r.nombre, `${r.organismo} (${r.region})`, `Cierre: ${fecha(r.cierre)} · ${r.monto_clp == null ? 'monto no publicado' : clp.format(r.monto_clp)}`]))\n      .on('mouseleave', () => tip.hide());\n    box.style.minHeight = H + 'px';\n  }\n\n  function grafPrecios() {\n    const box = document.getElementById('chart-precios');\n    const s = dash.data('resultados');\n    if (s.status === 'error') { fallo(box); return; }\n    if (s.status !== 'ok') return;\n    box.replaceChildren();\n    const colores = { 'compra ágil': C.blue, 'licitación': C.purple };\n    leyenda(document.getElementById('leyenda-precios'), [['Ganador · Compra Ágil', C.blue], ['Ganador · licitación', C.purple], ['JUNCOS', C.pink]]);\n    const rows = s.data.filter((r) => r.ratio_ganador > 0).sort((a, b) => a.ratio_ganador - b.ratio_ganador);\n    if (!rows.length) { const p = document.createElement('p'); p.className = 'nx-empty'; p.textContent = 'Todavía no hay procesos cerrados con precio ganador conocido.'; box.append(p); return; }\n    const W = Math.max(280, box.clientWidth), apilado = W < 620, rowH = apilado ? 38 : 24, top = 24, bottom = 10;\n    const H = top + rows.length * rowH + bottom;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Precio ganador como porcentaje del monto disponible');\n    const etiqueta = (r) => `${r.codigo.replace(/-(COT|LE|LP|L1)26$/, '')} · ${r.organismo}`;\n    let left = 8;\n    if (!apilado) {\n      const tmp = svg.append('text').attr('font-size', 12).style('font-family', 'var(--nx-font)');\n      left = 8 + Math.min(W * 0.42, d3.max(rows, (r) => { tmp.text(etiqueta(r)); return tmp.node().getComputedTextLength(); }));\n      tmp.remove();\n    }\n    const x = d3.scaleLinear([0, 1.1], [left, W - 16]);\n    const g = svg.append('g');\n    const ticks = [0, .25, .5, .75, 1];\n    g.selectAll('line.grid').data(ticks).join('line').attr('x1', (d) => x(d)).attr('x2', (d) => x(d)).attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', (d) => d === 1 ? 'var(--cds-chart-axis)' : 'var(--cds-chart-grid)');\n    g.selectAll('text.tick').data(ticks).join('text').attr('x', (d) => x(d)).attr('y', 12).attr('text-anchor', 'middle').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--nx-font)').text((d) => pct(d));\n    const med = d3.median(rows, (r) => r.ratio_ganador);\n    g.append('line').attr('x1', x(med)).attr('x2', x(med)).attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', C.pink).attr('stroke-width', 2).attr('stroke-dasharray', '4 4');\n    const tip = tooltip(box);\n    const fila = g.selectAll('g.r').data(rows).join('g').attr('transform', (r, i) => `translate(0, ${top + i * rowH})`);\n    fila.append('text').attr('x', apilado ? 0 : left - 8).attr('y', apilado ? 12 : 15).attr('text-anchor', apilado ? 'start' : 'end').attr('font-size', 12).attr('fill', 'var(--color-fg)').style('font-family', 'var(--nx-font)')\n      .text(etiqueta).each(function () { textoCorto.call(this, apilado ? W - 4 : left - 12); });\n    const yL = apilado ? 27 : 11;\n    fila.filter((r) => r.ratio_juncos > 0).append('line').attr('x1', (r) => x(Math.min(r.ratio_ganador, r.ratio_juncos))).attr('x2', (r) => x(Math.max(r.ratio_ganador, r.ratio_juncos))).attr('y1', yL).attr('y2', yL).attr('stroke', C.pink).attr('stroke-width', 2);\n    fila.append('circle').attr('cx', (r) => x(r.ratio_ganador)).attr('cy', yL).attr('r', 6).attr('fill', (r) => colores[r.tipo] || C.blue);\n    fila.filter((r) => r.ratio_juncos > 0).append('rect').attr('x', (r) => x(r.ratio_juncos) - 6).attr('y', yL - 6).attr('width', 12).attr('height', 12).attr('transform', (r) => `rotate(45 ${x(r.ratio_juncos)} ${yL})`).attr('fill', C.pink);\n    fila.append('rect').attr('x', 0).attr('y', 0).attr('width', W).attr('height', rowH).attr('fill', 'transparent')\n      .on('mousemove', (ev, r) => tip.show(ev, [`${r.codigo} · ${r.tipo}`, r.nombre, `Ganó ${r.ganador || '—'} con ${clp.format(r.precio_ganador)} (${pct(r.ratio_ganador)} de ${clp.format(r.monto_clp)})`, `${r.ofertas_final == null ? '—' : r.ofertas_final} ofertas` + (r.precio_ofertado ? ` · JUNCOS ofertó ${clp.format(r.precio_ofertado)} (${pct(r.ratio_juncos)})` : '')]))\n      .on('mouseleave', () => tip.hide());\n    box.style.minHeight = H + 'px';\n  }\n\n  function grafTerminos() {\n    const box = document.getElementById('chart-terminos');\n    const s = dash.data('mejora_terminos');\n    if (s.status === 'error') { fallo(box); return; }\n    if (s.status !== 'ok') return;\n    box.replaceChildren();\n    const rows = s.data.slice().sort((a, b) => b.afines - a.afines || a.termino.localeCompare(b.termino, 'es'));\n    if (!rows.some((r) => r.afines > 0)) { const p = document.createElement('p'); p.className = 'nx-empty'; p.textContent = 'Aún no hay procesos con registro de búsqueda en los últimos 30 días. Se llena con cada revisión diaria.'; box.append(p); return; }\n    const W = Math.max(280, box.clientWidth), rowH = 22, top = 8, H = top + rows.length * rowH + 8;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Procesos afines por término de búsqueda');\n    const tmp = svg.append('text').attr('font-size', 12);\n    const left = 8 + d3.max(rows, (r) => { tmp.text(r.termino); return tmp.node().getComputedTextLength(); }); tmp.remove();\n    const x = d3.scaleLinear([0, d3.max(rows, (r) => r.afines) || 1], [left + 4, W - 40]);\n    const g = svg.selectAll('g').data(rows).join('g').attr('transform', (r, i) => `translate(0, ${top + i * rowH})`);\n    g.append('text').attr('x', left - 4).attr('y', 14).attr('text-anchor', 'end').attr('font-size', 12).attr('fill', 'var(--color-fg)').style('font-family', 'var(--nx-font)').text((r) => r.termino);\n    g.append('rect').attr('x', x(0)).attr('y', 4).attr('height', 14).attr('width', (r) => Math.max(0, x(r.afines) - x(0))).attr('fill', C.blue);\n    g.append('rect').attr('x', x(0)).attr('y', 4).attr('height', 14).attr('width', (r) => Math.max(0, x(r.cotizadas) - x(0))).attr('fill', C.pink);\n    g.append('text').attr('x', (r) => x(r.afines) + 4).attr('y', 15).attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--nx-font)').text((r) => r.cotizadas ? `${r.afines} · ${r.cotizadas} cot.` : String(r.afines));\n    box.style.minHeight = H + 'px';\n  }\n\n  function tablaRes() {\n    const body = document.querySelector('#tabla-res tbody');\n    const s = dash.data('resultados');\n    if (s.status !== 'ok') return;\n    body.replaceChildren();\n    s.data.filter((r) => r.estado_final && r.estado_final !== 'abierta').forEach((r) => {\n      const tr = body.insertRow();\n      td(tr, r.codigo, 'code');\n      td(tr, r.nombre, 'wide');\n      td(tr, r.organismo);\n      td(tr, pill(r.estado_final));\n      td(tr, r.ofertas_final, 'num');\n      td(tr, r.ganador);\n      td(tr, r.precio_ganador ? clp.format(r.precio_ganador) : '—', 'num');\n      td(tr, r.ratio_ganador ? pct(r.ratio_ganador) : '—', 'num');\n      td(tr, r.precio_ofertado ? clp.format(r.precio_ofertado) : (r.juncos_cotizo || '—'), 'num');\n      td(tr, r.notas, 'wide');\n    });\n  }\n\n  function tablaPrecios() {\n    const body = document.querySelector('#tabla-precios tbody');\n    const s = dash.data('mejora_precios');\n    if (s.status !== 'ok') return;\n    body.replaceChildren();\n    if (!s.data.length) { const tr = body.insertRow(); const c = td(tr, 'Sin resultados todavía.'); c.colSpan = 4; return; }\n    s.data.forEach((r) => { const tr = body.insertRow(); td(tr, r.grupo); td(tr, r.resultados, 'num'); td(tr, pct(r.mediana_ratio), 'num'); td(tr, r.mediana_ofertas, 'num'); });\n  }\n\n  function listaSimple(id, fuente, crear, vacio) {\n    const el = document.getElementById(id);\n    const s = dash.data(fuente);\n    if (s.status === 'error') { fallo(el); return; }\n    if (s.status !== 'ok') return;\n    el.replaceChildren();\n    if (!s.data.length) { const li = document.createElement('li'); li.className = 'nx-empty'; li.textContent = vacio; el.append(li); return; }\n    s.data.forEach((r, i) => el.append(crear(r, i)));\n  }\n\n  function mejora() {\n    cifras('cifras-mejora', 'mejora_resumen', (k, v) => k === 'mediana_ratio_ganador' || k === 'concordancia' ? pct(v) : String(v == null ? '—' : v));\n    const m = dash.data('mejora_resumen');\n    if (m.status === 'ok' && m.data[0]) document.getElementById('nota-concordancia').textContent = `coincidencia entre recomendación y decisión (${m.data[0].pares_concordancia} casos)`;\n    grafPrecios(); grafTerminos(); tablaRes(); tablaPrecios();\n    listaSimple('lista-sug', 'mejora_sugerencias', (r) => { const li = document.createElement('li'); const t = document.createElement('span'); t.textContent = r.texto; t.setAttribute('data-source', 'mejora_sugerencias'); t.setAttribute('data-field', 'texto'); t.setAttribute('data-where', 'n=' + r.n); li.append(t); return li; }, 'Ninguna esta semana.');\n    listaSimple('lista-motivos', 'mejora_motivos', (r) => { const li = document.createElement('li'); li.className = 'alerta'; const dot = document.createElement('span'); dot.className = 'dot'; const t = document.createElement('span'); t.textContent = `${r.motivo}: ${r.veces}`; li.append(dot, t); return li; }, 'Aún no hay descartes con motivo registrado.');\n  }\n\n  function dibujar() {\n    cabecera();\n    if (!document.getElementById('hoy').hidden) {\n      cifras('cifras', 'resumen', (k, v) => k === 'ca_monto_abiertas' ? clpCorto(v || 0) : String(v));\n      grafCierres(); tablaCA(); tablaLic(); tablaTareas(); empresa();\n    } else {\n      mejora();\n    }\n  }\n  dash.onData(dibujar);\n  const inicial = location.hash.slice(1);\n  if (vistas.includes(inicial)) mostrar(inicial);\n})();\n</script>\n"}