{"text": "<style>\n#dash-root .jx { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); font-variant-numeric: tabular-nums; }\n#dash-root .jx-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n#dash-root .jx-take { margin: var(--cds-gap-xs) 0 0; font-size: var(--cds-font-size-body); max-width: 70ch; }\n#dash-root .jx-when { margin: var(--cds-gap-xs) 0 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n#dash-root .jx-tiles { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); }\n#dash-root .jx-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; }\n#dash-root .jx-tile .lbl { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .jx-tile .big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.1; min-height: 1.1em; }\n#dash-root .jx-tile .note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .jx-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; display: grid; gap: var(--cds-gap-sm); align-content: start; }\n#dash-root .jx-card h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n#dash-root .jx-card .sub { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 80ch; }\n#dash-root .jx-grid2 { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }\n#dash-root .jx-chart { position: relative; min-height: 220px; }\n#dash-root .jx-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .jx-legend i { display: inline-block; width: .6rem; height: .6rem; border-radius: 50%; margin-right: .35rem; vertical-align: middle; }\n#dash-root .jx-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); max-width: 18rem; z-index: 2; }\n#dash-root .jx-tip .t { color: var(--cds-text-secondary); }\n#dash-root .jx-scroll { overflow-x: auto; }\n#dash-root table.jx-t { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); }\n#dash-root .jx-t th { text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n#dash-root .jx-t th button { all: unset; cursor: pointer; }\n#dash-root .jx-t th button:focus-visible { outline: 2px solid var(--color-fg-muted); outline-offset: 2px; border-radius: 2px; }\n#dash-root .jx-t td { padding: var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n#dash-root .jx-t td.num { text-align: right; white-space: nowrap; }\n#dash-root .jx-t th.num { text-align: right; }\n#dash-root .jx-t td.code { white-space: nowrap; font-weight: var(--cds-font-weight-medium); }\n#dash-root .jx-t td.wide { min-width: 14rem; }\n#dash-root .jx-t tr.closed td { color: var(--color-fg-muted); }\n#dash-root .jx-t a { color: inherit; }\n#dash-root .jx-pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: var(--cds-font-size-caption); white-space: nowrap; border: 1px solid var(--color-border-line); }\n#dash-root .jx-pill.urg { color: var(--color-bad); border-color: currentColor; }\n#dash-root .jx-pill.ok { color: var(--color-ok); border-color: currentColor; }\n#dash-root .jx-pill.warn { color: var(--color-warn); border-color: currentColor; }\n#dash-root .jx-pill.mute { color: var(--color-fg-muted); }\n#dash-root .jx-rel { display: block; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n#dash-root .jx-rel.hot { color: var(--color-bad); }\n#dash-root .jx-search { width: 100%; max-width: 20rem; padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); font: inherit; }\n#dash-root .jx-co { display: grid; gap: var(--cds-gap-sm); margin: 0; padding: 0; list-style: none; }\n#dash-root .jx-co li { display: grid; grid-template-columns: .6rem 1fr; gap: var(--cds-gap-sm); align-items: baseline; font-size: var(--cds-font-size-caption); }\n#dash-root .jx-co li .dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--color-fg-muted); transform: translateY(-1px); }\n#dash-root .jx-co li.alerta .dot { background: var(--color-warn); }\n#dash-root .jx-co li.revisar .dot { background: var(--color-bad); }\n#dash-root .jx-co li.ok .dot { background: var(--color-ok); }\n#dash-root .jx-co li b { font-weight: var(--cds-font-weight-medium); }\n#dash-root .jx-fail { display: flex; align-items: center; justify-content: center; gap: .5rem; min-height: 4rem; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n#dash-root .jx-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n#dash-root [data-dash-source-state=empty] { color: transparent; }\n#dash-root [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n#dash-root .jx-foot { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; max-width: 90ch; }\n</style>\n\n<div class=\"jx\">\n  <header class=\"jx-head\" id=\"inicio\">\n    <h1>Tablero JUNCOS · Mercado Público</h1>\n    <p class=\"jx-take dash-skeleton\" id=\"takeaway\">—</p>\n    <p class=\"jx-when\"><span data-source=\"consulta\" data-field=\"consultado\" data-row=\"0\" id=\"cuando\" class=\"dash-skeleton\">—</span></p>\n  </header>\n\n  <section class=\"jx-tiles\" id=\"cifras\" aria-label=\"Cifras clave\">\n    <div class=\"jx-tile\"><span class=\"lbl\">Compras Ágiles abiertas</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"ca_abiertas\" data-row=\"0\">—</span><span class=\"note\">de las que sigue JUNCOS</span></div>\n    <div class=\"jx-tile\"><span class=\"lbl\">Monto disponible en ellas</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"ca_monto_abiertas\" data-row=\"0\">—</span><span class=\"note\">con impuestos</span></div>\n    <div class=\"jx-tile\"><span class=\"lbl\">Licitaciones abiertas</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"lic_abiertas\" data-row=\"0\">—</span><span class=\"note\">en seguimiento</span></div>\n    <div class=\"jx-tile\"><span class=\"lbl\">Cierran en 72 horas</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"cierran_72h\" data-row=\"0\">—</span><span class=\"note\">Compras Ágiles y licitaciones</span></div>\n    <div class=\"jx-tile\"><span class=\"lbl\">Tareas pendientes</span><span class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"tareas_pendientes\" data-row=\"0\">—</span><span class=\"note\">de la empresa</span></div>\n  </section>\n\n  <section class=\"jx-card\" id=\"calendario\">\n    <h2>Calendario de cierres</h2>\n    <p class=\"sub\">Cada línea va desde la consulta hasta el cierre de un proceso abierto. Las de la Región de Coquimbo van en negrita.</p>\n    <div class=\"jx-legend\" id=\"leyenda\"></div>\n    <div class=\"jx-chart\" id=\"chart\" data-source=\"cierres\"></div>\n  </section>\n\n  <section class=\"jx-card\" id=\"compras-agiles\">\n    <h2>Compras Ágiles</h2>\n    <p class=\"sub\">El número es la prioridad: primero las que conviene cotizar (CA3 de 7 o más, o listas para enviar), por fecha de cierre, y después las demás abiertas. CA3 es la decisión rápida de la skill. El neto máximo es el monto disponible dividido por 1,19.</p>\n    <label class=\"sub\" for=\"buscar-ca\">Buscar</label>\n    <input id=\"buscar-ca\" class=\"jx-search\" type=\"search\" placeholder=\"Código, organismo o región\">\n    <div class=\"jx-scroll\">\n      <table class=\"jx-t\" id=\"tabla-ca\" data-source=\"compras_agiles\" data-row-key=\"codigo\">\n        <thead><tr>\n          <th data-field=\"prioridad\"><button type=\"button\" data-k=\"prioridad\">#</button></th>\n          <th data-field=\"codigo\"><button type=\"button\" data-k=\"codigo\">Código</button></th>\n          <th data-field=\"nombre\">Qué piden</th>\n          <th data-field=\"organismo\"><button type=\"button\" data-k=\"organismo\">Organismo</button></th>\n          <th data-field=\"region\"><button type=\"button\" data-k=\"region\">Región</button></th>\n          <th data-field=\"monto_clp\" class=\"num\"><button type=\"button\" data-k=\"monto_clp\">Monto</button></th>\n          <th data-field=\"neto_max_clp\" class=\"num\">Neto máx.</th>\n          <th data-field=\"cierre\"><button type=\"button\" data-k=\"cierre\">Cierre</button></th>\n          <th data-field=\"ofertas_api_hoy\" class=\"num\">Ofertas</th>\n          <th data-field=\"ca3\" class=\"num\"><button type=\"button\" data-k=\"ca3\">CA3</button></th>\n          <th data-field=\"estado_juncos\">Estado</th>\n          <th data-field=\"rubro\">Rubro</th>\n          <th data-field=\"proximo_paso\">Próximo paso</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n    <p class=\"jx-foot\">Ofertas: mientras una Compra Ágil está abierta, la API muestra 0 o un número desfasado. El conteo real aparece cuando cierra.</p>\n  </section>\n\n  <section class=\"jx-card\" id=\"licitaciones\">\n    <h2>Licitaciones en seguimiento</h2>\n    <p class=\"sub\">Ordenadas por fecha de cierre. El código abre la ficha en Mercado Público.</p>\n    <div class=\"jx-scroll\">\n      <table class=\"jx-t\" id=\"tabla-lic\" data-source=\"licitaciones\" data-row-key=\"codigo\">\n        <thead><tr>\n          <th data-field=\"codigo\">Código</th>\n          <th data-field=\"nombre\">Objeto</th>\n          <th data-field=\"organismo\">Organismo</th>\n          <th data-field=\"region\">Región</th>\n          <th data-field=\"monto_clp\" class=\"num\">Monto</th>\n          <th data-field=\"cierre\">Cierre</th>\n          <th data-field=\"estado_juncos\">Estado</th>\n          <th data-field=\"proximo_paso\">Próximo paso</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <div class=\"jx-grid2\">\n    <section class=\"jx-card\" id=\"tareas\">\n      <h2>Tareas de la empresa</h2>\n      <p class=\"sub\">Primero las de hoy, al final las ya hechas.</p>\n      <div class=\"jx-scroll\">\n        <table class=\"jx-t\" id=\"tabla-tareas\" data-source=\"tareas\" data-row-key=\"n\">\n          <thead><tr>\n            <th data-field=\"n\">N°</th>\n            <th data-field=\"tarea\">Tarea</th>\n            <th data-field=\"plazo\">Plazo</th>\n            <th data-field=\"estado\">Estado</th>\n          </tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </section>\n    <section class=\"jx-card\" id=\"empresa\">\n      <h2>Ficha de la empresa</h2>\n      <p class=\"sub\">CONSULTORES NICOLÁS PÉREZ ALLENDES E.I.R.L. (JUNCOS), RUT 78.390.884-0.</p>\n      <ul class=\"jx-co\" id=\"lista-empresa\"></ul>\n    </section>\n  </div>\n</div>\n\n<script>\ndash.calc('resumen', {\n  title: 'Resumen de procesos abiertos',\n  description: 'Cuenta lo abierto a la hora de la consulta, suma el monto disponible de las Compras Ágiles abiertas y cuenta las tareas sin hacer.',\n  inputs: ['compras_agiles', 'licitaciones', 'tareas', 'consulta'],\n  fn: (compras_agiles, licitaciones, tareas, consulta) => {\n    const t0 = new Date(consulta[0].consultado).getTime();\n    const t72 = t0 + 72 * 3600 * 1000;\n    const abierta = (r) => new Date(r.cierre).getTime() > t0;\n    const ca = compras_agiles.filter(abierta);\n    const lic = licitaciones.filter(abierta);\n    const pronto = ca.concat(lic).filter((r) => new Date(r.cierre).getTime() <= t72);\n    return [{\n      ca_abiertas: ca.length,\n      ca_monto_abiertas: ca.reduce((s, r) => s + r.monto_clp, 0),\n      lic_abiertas: lic.length,\n      cierran_72h: pronto.length,\n      tareas_pendientes: tareas.filter((r) => r.estado !== 'Hecho').length\n    }];\n  }\n});\n\ndash.calc('cierres', {\n  title: 'Cierres de procesos abiertos',\n  description: 'Une Compras Ágiles y licitaciones que seguían abiertas a la hora de la consulta, ordenadas por cierre.',\n  inputs: ['compras_agiles', 'licitaciones', 'consulta'],\n  fn: (compras_agiles, licitaciones, consulta) => {\n    const t0 = new Date(consulta[0].consultado).getTime();\n    const pick = (tipo) => (r) => ({ codigo: r.codigo, tipo, nombre: r.nombre, organismo: r.organismo, region: r.region, en_region_coquimbo: r.en_region_coquimbo, monto_clp: r.monto_clp, cierre: r.cierre, estado_juncos: r.estado_juncos });\n    return compras_agiles.map(pick('Compra Ágil')).concat(licitaciones.map(pick('Licitación')))\n      .filter((r) => new Date(r.cierre).getTime() > t0)\n      .sort((a, b) => new Date(a.cierre) - new Date(b.cierre));\n  }\n});\n\n(function () {\n  const TZ = 'America/Santiago';\n  const clp = new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 });\n  const clpCorto = (v) => v >= 1e6 ? '$' + (v / 1e6).toLocaleString('es-CL', { maximumFractionDigits: 1 }) + ' M' : clp.format(v);\n  const partes = (d) => Object.fromEntries(new Intl.DateTimeFormat('es-CL', { weekday: 'short', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: TZ }).formatToParts(d).map((p) => [p.type, p.value]));\n  const fecha = (iso) => { const p = partes(new Date(iso)); return `${p.weekday.replace('.', '')} ${p.day}-${p.month}, ${p.hour}:${p.minute}`; };\n  const fechaCorta = (d) => { const p = partes(d); return `${p.weekday.replace('.', '')} ${p.day}-${p.month}`; };\n  const diaCL = (d) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(d);\n  const relativo = (iso) => {\n    const c = new Date(iso), now = new Date();\n    if (c <= now) return { txt: 'cerrada', hot: false };\n    const dd = Math.round((new Date(diaCL(c)) - new Date(diaCL(now))) / 864e5);\n    if (dd === 0) return { txt: 'cierra hoy', hot: true };\n    if (dd === 1) return { txt: 'cierra mañana', hot: true };\n    return { txt: `en ${dd} días`, hot: false };\n  };\n  const pillClase = (e) => /hoy/i.test(e) ? 'urg' : /Lista|Postulando/.test(e) ? 'ok' : /Cerr|Vencida/.test(e) ? 'mute' : /Alternativa|UTP/.test(e) ? 'mute' : /Revisar/.test(e) ? 'urg' : /Hecho/.test(e) ? 'ok' : /Pendiente/.test(e) ? 'warn' : '';\n  const pill = (txt) => { const s = document.createElement('span'); s.className = 'jx-pill ' + pillClase(txt); s.textContent = txt; return s; };\n  const td = (tr, txt, cls) => { const c = tr.insertCell(); if (cls) c.className = cls; if (txt instanceof Node) c.append(txt); else c.textContent = txt == null ? '—' : txt; return c; };\n  const fallo = (el) => { el.replaceChildren(); const d = document.createElement('div'); d.className = 'jx-fail'; d.textContent = 'Failed to load'; el.append(d); };\n  const sinSkel = (...els) => els.forEach((e) => e && e.classList.remove('dash-skeleton'));\n\n  let ordenCA = { k: 'prioridad', dir: 1 };\n  document.querySelectorAll('#tabla-ca th button').forEach((b) => b.addEventListener('click', () => {\n    const k = b.dataset.k; ordenCA = { k, dir: ordenCA.k === k ? -ordenCA.dir : 1 };\n    document.querySelectorAll('#tabla-ca th').forEach((th) => th.removeAttribute('aria-sort'));\n    b.closest('th').setAttribute('aria-sort', ordenCA.dir > 0 ? 'ascending' : 'descending');\n    dibujar();\n  }));\n  document.getElementById('buscar-ca').addEventListener('input', () => dibujar());\n\n  function tablaCA() {\n    const body = document.querySelector('#tabla-ca tbody');\n    const s = dash.data('compras_agiles');\n    if (s.status === 'error') { body.replaceChildren(); return; }\n    if (s.status !== 'ok') return;\n    const q = document.getElementById('buscar-ca').value.trim().toLowerCase();\n    const { k, dir } = ordenCA;\n    const val = (r) => k === 'cierre' ? new Date(r.cierre).getTime() : r[k];\n    const rows = s.data.filter((r) => !q || [r.codigo, r.organismo, r.region, r.nombre].join(' ').toLowerCase().includes(q))\n      .slice().sort((a, b) => {\n        const va = val(a), vb = val(b);\n        if (va == null && vb == null) return 0; if (va == null) return 1; if (vb == null) return -1;\n        return (typeof va === 'number' ? va - vb : String(va).localeCompare(String(vb), 'es')) * dir;\n      });\n    body.replaceChildren();\n    rows.forEach((r) => {\n      const tr = body.insertRow();\n      const rel = relativo(r.cierre);\n      if (rel.txt === 'cerrada') tr.className = 'closed';\n      td(tr, r.prioridad == null ? '—' : r.prioridad, 'num');\n      td(tr, r.codigo, 'code');\n      td(tr, r.nombre, 'wide');\n      td(tr, r.organismo);\n      td(tr, r.region);\n      td(tr, clp.format(r.monto_clp), 'num');\n      td(tr, clp.format(r.neto_max_clp), 'num');\n      const c = td(tr, fecha(r.cierre)); c.style.whiteSpace = 'nowrap';\n      const sp = document.createElement('span'); sp.className = 'jx-rel' + (rel.hot ? ' hot' : ''); sp.textContent = rel.txt + (r.llamado === 'Segundo llamado' ? ' · 2.º llamado' : ''); c.append(sp);\n      td(tr, r.ofertas_api_hoy, 'num');\n      td(tr, r.ca3 == null ? '—' : r.ca3, 'num');\n      td(tr, pill(r.estado_juncos));\n      td(tr, r.rubro);\n      td(tr, r.proximo_paso, 'wide');\n    });\n  }\n\n  function tablaLic() {\n    const body = document.querySelector('#tabla-lic tbody');\n    const s = dash.data('licitaciones');\n    if (s.status !== 'ok') return;\n    body.replaceChildren();\n    s.data.slice().sort((a, b) => new Date(a.cierre) - new Date(b.cierre)).forEach((r) => {\n      const tr = body.insertRow();\n      const rel = relativo(r.cierre);\n      if (rel.txt === 'cerrada') tr.className = 'closed';\n      const a = document.createElement('a'); a.href = r.ficha; a.target = '_blank'; a.rel = 'noopener'; a.textContent = r.codigo;\n      td(tr, a, 'code');\n      td(tr, r.nombre, 'wide');\n      td(tr, r.organismo);\n      td(tr, r.region);\n      td(tr, r.monto_clp == null ? 'No publica' : clp.format(r.monto_clp), 'num');\n      const c = td(tr, fecha(r.cierre)); c.style.whiteSpace = 'nowrap';\n      const sp = document.createElement('span'); sp.className = 'jx-rel' + (rel.hot ? ' hot' : ''); sp.textContent = rel.txt; c.append(sp);\n      td(tr, pill(r.estado_juncos));\n      td(tr, r.proximo_paso, 'wide');\n    });\n  }\n\n  function tablaTareas() {\n    const body = document.querySelector('#tabla-tareas tbody');\n    const s = dash.data('tareas');\n    if (s.status !== 'ok') return;\n    const peso = (r) => r.estado === 'Hecho' ? 3 : /^Hoy/.test(r.plazo) ? 0 : r.estado === 'Revisar' ? 1 : 2;\n    body.replaceChildren();\n    s.data.slice().sort((a, b) => peso(a) - peso(b) || a.n - b.n).forEach((r) => {\n      const tr = body.insertRow();\n      if (r.estado === 'Hecho') tr.className = 'closed';\n      td(tr, r.n, 'num');\n      td(tr, r.tarea, 'wide');\n      td(tr, r.plazo);\n      td(tr, pill(r.estado));\n    });\n  }\n\n  function empresa() {\n    const ul = document.getElementById('lista-empresa');\n    const s = dash.data('empresa');\n    if (s.status === 'error') { fallo(ul); return; }\n    if (s.status !== 'ok') return;\n    ul.replaceChildren();\n    s.data.forEach((r) => {\n      const li = document.createElement('li'); li.className = r.nivel;\n      const dot = document.createElement('span'); dot.className = 'dot';\n      const tx = document.createElement('span');\n      const b = document.createElement('b'); b.textContent = r.item + ': ';\n      const v = document.createElement('span'); v.textContent = r.valor;\n      v.setAttribute('data-source', 'empresa'); v.setAttribute('data-field', 'valor'); v.setAttribute('data-where', 'id=' + encodeURIComponent(r.id));\n      tx.append(b, v); li.append(dot, tx); ul.append(li);\n    });\n  }\n\n  function cifras() {\n    const s = dash.data('resumen');\n    const els = document.querySelectorAll('#cifras [data-source=\"resumen\"]');\n    els.forEach((el) => {\n      if (s.status !== 'ok') { if (s.status === 'error') { sinSkel(el); el.textContent = '—'; } return; }\n      sinSkel(el);\n      const v = s.data[0][el.dataset.field];\n      el.textContent = el.dataset.field === 'ca_monto_abiertas' ? clpCorto(v) : String(v);\n    });\n  }\n\n  function cabecera() {\n    const take = document.getElementById('takeaway');\n    const cuando = document.getElementById('cuando');\n    const c = dash.data('consulta');\n    if (c.status === 'ok') {\n      sinSkel(cuando);\n      const p = partes(new Date(c.data[0].consultado));\n      cuando.textContent = `Datos de Mercado Público consultados el ${p.weekday.replace('.', '')} ${p.day}-${p.month}-2026 a las ${p.hour}:${p.minute} (hora de Chile).`;\n    }\n    const s = dash.data('cierres');\n    if (s.status !== 'ok') return;\n    sinSkel(take);\n    take.replaceChildren();\n    const now = new Date();\n    const vivos = s.data.filter((r) => new Date(r.cierre) > now);\n    if (!vivos.length) { take.textContent = 'Todos los procesos de esta consulta ya cerraron: hay que actualizar el tablero.'; return; }\n    const r = vivos[0];\n    const i = s.data.indexOf(r);\n    const span = (txt, field) => { const e = document.createElement('b'); e.textContent = txt; e.setAttribute('data-source', 'cierres'); e.setAttribute('data-field', field); e.setAttribute('data-row', String(i)); return e; };\n    const hoyN = vivos.filter((x) => diaCL(new Date(x.cierre)) === diaCL(now)).length;\n    take.append(\n      document.createTextNode(hoyN > 1 ? `Hoy cierran ${hoyN} procesos. El primero es ` : 'El próximo cierre es '),\n      span(r.nombre, 'nombre'),\n      document.createTextNode(` (${r.codigo}, ${r.organismo}), `),\n      span(fecha(r.cierre), 'cierre'),\n      document.createTextNode('.')\n    );\n  }\n\n  function grafico() {\n    const box = document.getElementById('chart');\n    const ley = document.getElementById('leyenda');\n    const s = dash.data('cierres');\n    const c = dash.data('consulta');\n    if (s.status === 'error') { fallo(box); return; }\n    if (s.status !== 'ok' || c.status !== 'ok') return;\n    box.replaceChildren();\n    const colores = { 'Compra Ágil': dash.colors[0], 'Licitación': dash.colors[1] };\n    ley.replaceChildren(...Object.entries(colores).map(([k, col]) => { const sp = document.createElement('span'); const i = document.createElement('i'); i.style.background = col; sp.append(i, document.createTextNode(k)); return sp; }));\n    const rows = s.data;\n    const W = Math.max(280, box.clientWidth);\n    const apilado = W < 620;\n    const rowH = apilado ? 40 : 26;\n    const top = 26, bottom = 8;\n    const t0 = new Date(c.data[0].consultado);\n    const tMax = d3.max(rows, (r) => new Date(r.cierre));\n    const H = top + rows.length * rowH + bottom;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Calendario de cierres');\n    const etiqueta = (r) => `${r.codigo.replace(/-(COT|LE|LP|L1)26$/, '')} · ${r.organismo}`;\n    let left = 8;\n    if (!apilado) {\n      const tmp = svg.append('text').attr('font-size', 12).style('font-family', 'var(--font-anthropic-sans)');\n      left = 8 + Math.min(W * 0.42, d3.max(rows, (r) => { tmp.text(etiqueta(r)); return tmp.node().getComputedTextLength(); }));\n      tmp.remove();\n    }\n    const right = 56;\n    const x = d3.scaleUtc([t0, d3.utcHour.offset(tMax, 6)], [left, W - right]);\n    const dias = d3.utcDay.range(d3.utcDay.ceil(t0), tMax);\n    const paso = Math.max(1, Math.ceil(dias.length / Math.max(2, Math.floor((W - left - right) / 70))));\n    const g = svg.append('g');\n    g.selectAll('line.grid').data(dias).join('line').attr('x1', (d) => x(d)).attr('x2', (d) => x(d)).attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', 'var(--cds-chart-grid)').attr('stroke-width', 1);\n    g.selectAll('text.tick').data(dias.filter((_, i) => i % paso === 0)).join('text').attr('x', (d) => x(d) + 3).attr('y', 12).attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--font-anthropic-sans)').text((d) => fechaCorta(d3.utcHour.offset(d, 12)));\n    const ahora = new Date();\n    if (ahora > t0 && ahora < tMax) {\n      g.append('line').attr('x1', x(ahora)).attr('x2', x(ahora)).attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '3 3');\n      g.append('text').attr('x', x(ahora) + 3).attr('y', 24).attr('font-size', 10).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--font-anthropic-sans)').text('ahora');\n    }\n    const tip = document.createElement('div'); tip.className = 'jx-tip'; tip.hidden = true; box.append(tip);\n    const fila = g.selectAll('g.r').data(rows).join('g').attr('transform', (r, i) => `translate(0, ${top + i * rowH})`);\n    fila.append('text').attr('x', apilado ? 0 : left - 8).attr('y', apilado ? 13 : 16).attr('text-anchor', apilado ? 'start' : 'end').attr('font-size', 12)\n      .attr('font-weight', (r) => r.en_region_coquimbo ? 600 : 400).attr('fill', 'var(--color-fg)').style('font-family', 'var(--font-anthropic-sans)')\n      .text((r) => etiqueta(r)).each(function () {\n        const max = apilado ? W - 4 : left - 12;\n        let t = this.textContent;\n        while (this.getComputedTextLength() > max && t.length > 4) { t = t.slice(0, -2); this.textContent = t + '…'; }\n      });\n    const yL = apilado ? 28 : 12;\n    fila.append('line').attr('x1', x(t0)).attr('x2', (r) => x(new Date(r.cierre))).attr('y1', yL).attr('y2', yL).attr('stroke', (r) => colores[r.tipo]).attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('opacity', .45);\n    fila.append('circle').attr('cx', (r) => x(new Date(r.cierre))).attr('cy', yL).attr('r', 5).attr('fill', (r) => colores[r.tipo]);\n    fila.append('text').attr('x', (r) => x(new Date(r.cierre)) + 9).attr('y', yL + 4).attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-family', 'var(--font-anthropic-sans)')\n      .text((r) => { const p = partes(new Date(r.cierre)); return `${p.day}-${p.month}`; });\n    fila.append('rect').attr('x', 0).attr('y', 0).attr('width', W).attr('height', rowH).attr('fill', 'transparent')\n      .on('mousemove', (ev, r) => {\n        tip.hidden = false;\n        tip.replaceChildren();\n        const a = document.createElement('div'); a.className = 't'; a.textContent = `${r.tipo} · ${r.codigo}`;\n        const b = document.createElement('div'); b.textContent = r.nombre;\n        const c2 = document.createElement('div'); c2.textContent = `${r.organismo} (${r.region})`;\n        const d = document.createElement('div'); d.textContent = `Cierre: ${fecha(r.cierre)} · ${r.monto_clp == null ? 'monto no publicado' : clp.format(r.monto_clp)}`;\n        tip.append(a, b, c2, d);\n        const [mx, my] = d3.pointer(ev, box);\n        const tw = tip.offsetWidth;\n        tip.style.left = Math.max(0, Math.min(mx + 12, box.clientWidth - tw)) + 'px';\n        tip.style.top = (my + 14) + 'px';\n      })\n      .on('mouseleave', () => { tip.hidden = true; });\n    box.style.minHeight = H + 'px';\n  }\n\n  function dibujar() { cabecera(); cifras(); grafico(); tablaCA(); tablaLic(); tablaTareas(); empresa(); }\n  dash.onData(dibujar);\n})();\n</script>\n"}